---
// Pase.astro
import {
    NOMBRE_POR_DEFECTO,
    etiquetaPases,
    frasePresenciaPases,
} from "../lib/pases";

interface Props {
    numeroPases: number;
    nombreInvitado?: string;
}

const { numeroPases = 1, nombreInvitado = "" } = Astro.props;
---

<section class="relative w-full pt-10 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-pase">

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-pase">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden"
                    id="card-principal-pase"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/azul-vertical.webp"
                        alt="Fondo pase"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div class="relative px-6 pt-14 pb-10 z-10 text-center">

                        <!-- INVITACIÓN + NOMBRE DEL INVITADO -->
                        <div class="mb-5" id="titulo-pase">
                            <p
                                class="font-crimson text-sm uppercase tracking-[0.25em] text-white/80 font-semibold leading-relaxed mb-2"
                            >
                                Invitación con<br />mucho cariño para
                            </p>
                            <!-- El nombre puede bajar de renglón: no se fuerza a una sola línea -->
                            <h2
                                class="font-great-vibes text-[2.25rem] text-white leading-tight break-words"
                                id="nombre-invitado"
                            >
                                {nombreInvitado || NOMBRE_POR_DEFECTO}
                            </h2>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="flex items-center justify-center my-4 px-6">
                            <div class="flex-1 h-px bg-white/30"></div>
                            <div class="mx-3 text-[#C2A96B] text-xs">✦</div>
                            <div class="flex-1 h-px bg-white/30"></div>
                        </div>

                        <!-- PASES ASIGNADOS -->
                        <div class="mb-5" id="numero-pase">
                            <p
                                class="font-crimson text-sm uppercase tracking-[0.25em] text-white/80 font-semibold mb-3"
                            >
                                Pases asignados
                            </p>
                            <div
                                class="w-20 h-20 mx-auto rounded-full border border-white/40 bg-white/10 flex items-center justify-center shadow-lg"
                            >
                                <span
                                    class="text-white font-bold leading-none text-[2.75rem]"
                                    id="numero-pases"
                                >
                                    {numeroPases}
                                </span>
                            </div>
                            <p
                                class="font-crimson text-sm uppercase tracking-[0.3em] text-white/80 font-semibold mt-3"
                                id="etiqueta-pases"
                            >
                                {etiquetaPases(numeroPases)}
                            </p>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div id="texto-pase">
                            <p
                                class="font-crimson text-lg leading-snug text-white italic"
                                id="frase-pases"
                            >
                                {frasePresenciaPases(numeroPases)}
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Datos del invitado desde el panel (link con ?i=codigo) -->
<script>
    import { datosInvitado, alCambiarInvitado } from "../lib/invitado";
    import type { Invitado } from "../lib/invitado";
    import { etiquetaPases, frasePresenciaPases } from "../lib/pases";

    function pintarPase(nombre: string | null, pases: number | null) {
        if (nombre) {
            const el = document.getElementById("nombre-invitado");
            if (el) el.textContent = nombre;
        }
        if (pases !== null && Number.isInteger(pases) && pases > 0) {
            const num = document.getElementById("numero-pases");
            const etiqueta = document.getElementById("etiqueta-pases");
            const frase = document.getElementById("frase-pases");
            if (num) num.textContent = String(pases);
            if (etiqueta) etiqueta.textContent = etiquetaPases(pases);
            if (frase) frase.textContent = frasePresenciaPases(pases);
        }
    }

    function mostrar(inv: Invitado | null) {
        if (!inv) return;
        const funciones = (inv.funciones || {}) as { pases?: boolean };
        const sinPases = funciones.pases === false;
        for (const id of ["numero-pase", "texto-pase"]) {
            const el = document.getElementById(id);
            if (el) el.style.display = sinPases ? "none" : "";
        }
        pintarPase(inv.nombre, sinPases ? null : inv.pases);
    }

    datosInvitado().then(mostrar);
    alCambiarInvitado(mostrar);
</script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-pase",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-pase",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#titulo-pase",
                { opacity: 0, y: -20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#numero-pase",
                { opacity: 0, scale: 0.8 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 1,
                    delay: 0.2,
                    ease: "back.out(1.4)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#texto-pase",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>
